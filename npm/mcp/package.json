{
  "name": "@agentic-robotics/mcp",
  "version": "0.2.7",
  "description": "Model Context Protocol server for agentic robotics with AgentDB integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentic-robotics-mcp": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/agentic-robotics.git"
  },
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "robotics",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "agentdb",
    "agentic-flow",
    "ai-agents",
    "ros2",
    "semantic-search",
    "vector-memory",
    "ruvector",
    "agentic-robotics"
  ],
  "engines": {
    "node": ">= 18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest",
    "benchmark": "tsx src/benchmark.ts",
    "benchmark:hybrid": "tsx src/hybrid-benchmark.ts"
  },
  "dependencies": {
    "@agentic-robotics/core": "^0.2.1",
    "@modelcontextprotocol/sdk": ">=1.25.4",
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  },
  "homepage": "https://ruv.io",
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "agentic-flow": "^2.0.14 || ^3.4.3"
  },
  "peerDependenciesMeta": {
    "agentic-flow": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "agentdb": "^3.7.2",
    "ruvector": "0.3.24"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/agentic-robotics/issues"
  }
}
