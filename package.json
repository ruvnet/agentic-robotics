{
  "name": "@ros3/workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "npm/core",
    "npm/cli",
    "npm/mcp",
    "npm/agentic-robotics",
    "examples/self-learning"
  ],
  "scripts": {
    "build": "npm run build:rust && npm run build:packages",
    "build:rust": "cargo build --release",
    "build:packages": "npm run build --workspaces --if-present",
    "test": "npm run test:rust && npm run test:packages",
    "test:rust": "cargo test",
    "test:packages": "npm run test --workspaces --if-present -- --run",
    "bench": "cargo bench",
    "dev": "npm run dev --workspace=@agentic-robotics/mcp"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "agentdb": "3.10.0",
    "agentic-flow": "^3.4.3",
    "@modelcontextprotocol/sdk": ">=1.25.4"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk",
    "vitest": "$vitest",
    "protobufjs": ">=7.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
